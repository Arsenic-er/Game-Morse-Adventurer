{
  "name": "cwgame",
  "version": "0.45.0",
  "description": "Pixel-art amateur radio CW station simulator",
  "author": "Arsenic-er <302726993@qq.com>",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm build:size",
    "build:size": "node scripts/report-build-size.mjs",
    "preview": "vite preview",
    "test": "node --test",
    "npc:generate": "node scripts/generate-npc-roster.mjs",
    "qso:simulate:poor": "node scripts/simulate-poor-qso.mjs",
    "qso:calibrate": "node scripts/calibrate-operators.mjs",
    "mission:economy": "node scripts/simulate-mission-economy.mjs",
    "semantic:model:sync": "node scripts/sync-semantic-model.mjs",
    "semantic:model:update": "node scripts/sync-semantic-model.mjs --update",
    "desktop:dev": "pnpm semantic:model:sync && vite build && electron .",
    "desktop:build": "pnpm semantic:model:sync && pnpm build && electron-builder --win portable"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "onnxruntime-node": "1.27.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "build": {
    "appId": "com.cwgame.station",
    "productName": "CWGame",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/font/**/*",
      "build/icon.ico",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/DirectML.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxcompiler.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxil.dll"
    ],
    "extraResources": [
      {
        "from": "runtime-models",
        "to": "models",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CWGame-latest.${ext}"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "vite": "6.4.3"
  },
  "pnpm": {
    "overrides": {
      "onnxruntime-node@1.27.0>adm-zip": "0.6.0"
    }
  }
}
